#!/usr/bin/env bash
set -euo pipefail

# git worktree helper (bare repo pattern)
# Layout: <project>/.bare/ + <project>/<branch>/

cmd="${1:-help}"
shift 2>/dev/null || true

_gwt_root() {
	local dir
	dir=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || {
		echo "Not in a git worktree repo" >&2
		return 1
	}
	echo "${dir%/.bare}"
}

# Check if cwd is a bare repo root (has .git file pointing to .bare/)
_is_bare_root() {
	[[ -f .git ]] && grep -q "gitdir: ./.bare" .git 2>/dev/null
}

# Detect the default branch (origin/HEAD -> main, develop, etc.)
_default_branch() {
	local branch common
	# `|| true`: symbolic-ref exits 1 when origin/HEAD is unset, which under
	# `set -e -o pipefail` would abort the script instead of falling back.
	branch=$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's|refs/remotes/origin/||') || true
	if [[ -z "$branch" ]]; then
		# `git clone --bare` doesn't create origin/HEAD, but it does point the
		# bare repo's own HEAD at the remote's default branch.
		common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || true
		[[ -n "$common" ]] && branch=$(git -C "$common" symbolic-ref --short HEAD 2>/dev/null) || true
	fi
	echo "${branch:-main}"
}

# Remove empty parent directories up to the project root
_cleanup_empty_parents() {
	local dir="$1" root="$2"
	dir=$(dirname "$dir")
	while [[ "$dir" != "$root" && "$dir" != "/" ]]; do
		if [[ -d "$dir" ]] && [ -z "$(ls -A "$dir" 2>/dev/null)" ]; then
			rmdir "$dir"
			dir=$(dirname "$dir")
		else
			break
		fi
	done
}

# Directory holding the gwt templates (CLAUDE.md, envrc, envrc.worktree)
_gwt_data_dir() {
	echo "${XDG_DATA_HOME:-$HOME/.local/share}/gwt"
}

# Install the shared direnv config at the worktree root and git-ignore the
# per-worktree stubs. Called once, by `gwt clone`.
_install_envrc_root() {
	local root="$1" data_dir
	data_dir=$(_gwt_data_dir)

	if [[ -f "$data_dir/envrc" && ! -f "$root/.envrc" ]]; then
		cp "$data_dir/envrc" "$root/.envrc"
		echo "==> Copied .envrc"
	fi
	if [[ -f "$data_dir/envrc.worktree" && ! -f "$root/.envrc.worktree" ]]; then
		cp "$data_dir/envrc.worktree" "$root/.envrc.worktree"
		echo "==> Copied .envrc.worktree"
	fi

	# Ignore the per-worktree stubs via .bare/info/exclude — shared by every
	# worktree, so it never has to touch a tracked .gitignore.
	local exclude="$root/.bare/info/exclude"
	mkdir -p "$(dirname "$exclude")"
	if ! grep -qxF '.envrc' "$exclude" 2>/dev/null; then
		printf '\n# direnv: per-worktree .envrc stub (gwt)\n.envrc\n' >> "$exclude"
	fi

	command -v direnv &>/dev/null && (cd "$root" && direnv allow) 2>/dev/null || true
}

# Write a worktree's 2-line .envrc stub and trust it with direnv.
# No-op unless the root carries this gwt's shared direnv config.
_install_envrc_stub() {
	local wt_path="$1" root="$2"
	[[ -f "$root/.envrc.worktree" ]] || return 0
	grep -q 'GWT_ROOT' "$root/.envrc" 2>/dev/null || return 0

	if [[ ! -f "$wt_path/.envrc" ]]; then
		# GWT_WORKTREE first: direnv's source_env cds to the sourced file's
		# directory, so .envrc.worktree cannot see which worktree loaded it.
		printf 'export GWT_WORKTREE="$PWD"\nsource_up\nsource_env "$GWT_ROOT/.envrc.worktree"\n' > "$wt_path/.envrc"
		echo "==> Created .envrc"
	fi
	if command -v direnv &>/dev/null; then
		(cd "$wt_path" && direnv allow) 2>/dev/null || true
	else
		echo "==> direnv not installed; run 'direnv allow' in $wt_path later"
	fi
}

_update_workspace() {
	local root="$1"
	# Find a *.code-workspace file at the root; skip if none exists
	local workspace_file
	workspace_file=$(find "$root" -maxdepth 1 -name "*.code-workspace" | head -1)
	[[ -z "$workspace_file" ]] && return 0

	local folders=()
	while IFS= read -r line; do
		local wt_path
		wt_path=$(echo "$line" | awk '{print $1}')
		[[ "$wt_path" == */.bare ]] && continue
		local rel="${wt_path#"$root/"}"
		folders+=("$rel")
	done < <(git -C "$root" worktree list)

	{
		printf '{\n'
		printf '  "folders": [\n'
		local last=$(( ${#folders[@]} - 1 ))
		local i
		for i in "${!folders[@]}"; do
			local f="${folders[$i]}"
			if (( i < last )); then
				printf '    { "name": "%s", "path": "%s" },\n' "$f" "$f"
			else
				printf '    { "name": "%s", "path": "%s" }\n' "$f" "$f"
			fi
		done
		printf '  ]\n'
		printf '}\n'
	} > "$workspace_file"

	echo "==> Updated: $(basename "$workspace_file")"
}

case "$cmd" in
clone)
	url="$1"
	dir="${2:-$(basename "$1" .git)}"
	if [[ -z "$url" ]]; then
		echo "Usage: gwt clone <url> [dir]" && exit 1
	fi
	git clone --bare "$url" "$dir/.bare"
	echo "gitdir: ./.bare" > "$dir/.git"
	cd "$dir"
	git config remote.origin.fetch "+refs/heads/*:refs/remotes/origin/*"
	git fetch origin
	default_branch=$(_default_branch)
	git worktree add "$default_branch" "$default_branch"
	# Shared direnv config at the root + stub in the first worktree
	_install_envrc_root "$PWD"
	_install_envrc_stub "$PWD/$default_branch" "$PWD"
	# Copy worktree-root CLAUDE.md template if available
	gwt_claude_md="$(_gwt_data_dir)/CLAUDE.md"
	if [[ -f "$gwt_claude_md" ]]; then
		cp "$gwt_claude_md" CLAUDE.md
		echo "==> Copied CLAUDE.md template"
	fi
	# Copy Claude settings.local.json for project-level permissions
	claude_local="$HOME/.claude/settings.local.json"
	if [[ -f "$claude_local" ]]; then
		mkdir -p .claude
		cp "$claude_local" .claude/settings.local.json
		echo "==> Copied .claude/settings.local.json"
	fi
	echo "==> Ready: cd $dir/$default_branch"
	;;
add)
	branch="$1"
	base="${2:-HEAD}"
	if [[ -z "$branch" ]]; then
		echo "Usage: gwt add <branch> [base]" && exit 1
	fi
	root=$(_gwt_root)
	git fetch origin 2>/dev/null || true
	if git show-ref --verify --quiet "refs/heads/$branch" 2>/dev/null; then
		git worktree add "$root/$branch" "$branch"
	elif git show-ref --verify --quiet "refs/remotes/origin/$branch" 2>/dev/null; then
		git worktree add --track -b "$branch" "$root/$branch" "origin/$branch"
	else
		git worktree add -b "$branch" "$root/$branch" "$base"
	fi
	_install_envrc_stub "$root/$branch" "$root"
	_update_workspace "$root"
	echo "==> cd $root/$branch"
	;;
rm)
	branch="$1"
	if [[ -z "$branch" ]]; then
		echo "Usage: gwt rm <branch>" && exit 1
	fi
	root=$(_gwt_root)
	git worktree remove "$root/$branch"
	_cleanup_empty_parents "$root/$branch" "$root"
	_update_workspace "$root"
	;;
ls)
	git worktree list
	;;
status|st)
	target="${1:-$(_default_branch)}"
	git_common_dir=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)
	has_gh=false
	command -v gh &>/dev/null && has_gh=true

	# Last fetch time
	fetch_head="$git_common_dir/FETCH_HEAD"
	if [[ -f "$fetch_head" ]]; then
		if [[ "$(uname -s)" == Darwin ]]; then
			fetch_epoch=$(stat -f %m "$fetch_head")
		else
			fetch_epoch=$(stat -c %Y "$fetch_head")
		fi
		now=$(date +%s)
		ago=$(( now - fetch_epoch ))
		if (( ago < 60 )); then
			fetch_ago="${ago}s ago"
		elif (( ago < 3600 )); then
			fetch_ago="$(( ago / 60 ))m ago"
		elif (( ago < 86400 )); then
			fetch_ago="$(( ago / 3600 ))h ago"
		else
			fetch_ago="$(( ago / 86400 ))d ago"
		fi
		echo "Last fetch: $(date -r "$fetch_epoch" '+%Y-%m-%d %H:%M:%S') ($fetch_ago)"
	else
		echo "Last fetch: never"
	fi
	echo ""

	# Worktree branches vs origin
	echo "Worktrees (target: $target):"
	while IFS= read -r line; do
		wt_path=$(echo "$line" | awk '{print $1}')
		wt_commit=$(echo "$line" | awk '{print $2}')
		wt_branch=$(echo "$line" | sed -n 's/.*\[\(.*\)\].*/\1/p')

		[[ "$wt_path" == */.bare ]] && continue
		[[ -z "$wt_branch" ]] && continue

		# Check against origin
		local_commit=$(git rev-parse --short "refs/heads/$wt_branch" 2>/dev/null || echo "?")

		if ! git show-ref --verify --quiet "refs/remotes/origin/$wt_branch" 2>/dev/null; then
			sync="local only"
		elif [[ "$local_commit" == "$(git rev-parse --short "refs/remotes/origin/$wt_branch" 2>/dev/null)" ]]; then
			sync="synced"
		else
			ahead=$(git rev-list --count "refs/remotes/origin/$wt_branch..refs/heads/$wt_branch" 2>/dev/null || echo 0)
			behind=$(git rev-list --count "refs/heads/$wt_branch..refs/remotes/origin/$wt_branch" 2>/dev/null || echo 0)
			parts=()
			(( ahead > 0 )) && parts+=("${ahead} ahead")
			(( behind > 0 )) && parts+=("${behind} behind")
			sync=$(printf '%s, ' "${parts[@]}"); sync="${sync%, }"
		fi

		# Check working tree for dirty state
		dirty=""
		wt_status=$(git -C "$wt_path" status --porcelain 2>/dev/null || true)
		if [[ -n "$wt_status" ]]; then
			has_staged=false
			has_unstaged=false
			has_untracked=false
			while IFS= read -r st_line; do
				index="${st_line:0:1}"
				worktree="${st_line:1:1}"
				if [[ "$index" == "?" ]]; then
					has_untracked=true
				else
					[[ "$index" != " " && "$index" != "?" ]] && has_staged=true
					[[ "$worktree" != " " && "$worktree" != "?" ]] && has_unstaged=true
				fi
			done <<< "$wt_status"
			dirty_parts=()
			[[ "$has_staged" == true ]] && dirty_parts+=("staged")
			[[ "$has_unstaged" == true ]] && dirty_parts+=("unstaged")
			[[ "$has_untracked" == true ]] && dirty_parts+=("untracked")
			dirty=$(printf '%s, ' "${dirty_parts[@]}"); dirty="${dirty%, }"
		fi

		# Merge status
		merge_info=""
		if [[ "$wt_branch" == "$target" ]]; then
			merge_info=""
		elif git merge-base --is-ancestor "refs/heads/$wt_branch" "refs/remotes/origin/$target" 2>/dev/null; then
			# Regular merge — branch commits are ancestors of target
			pr_info=""
			if [[ "$has_gh" == true ]]; then
				pr_info=$(gh pr list --head "$wt_branch" --state merged --json number,title --limit 1 --jq 'if length > 0 then "#\(.[0].number) \(.[0].title)" else empty end' 2>/dev/null || true)
			fi
			if [[ -n "$pr_info" ]]; then
				merge_info="merged via $pr_info"
			else
				merge_info="merged"
			fi
		else
			# Not a git ancestor — check gh for squash/rebase merges and open PRs
			if [[ "$has_gh" == true ]]; then
				merged_pr=$(gh pr list --head "$wt_branch" --state merged --json number,title --limit 1 --jq 'if length > 0 then "#\(.[0].number) \(.[0].title)" else empty end' 2>/dev/null || true)
				if [[ -n "$merged_pr" ]]; then
					merge_info="merged via $merged_pr"
				else
					open_pr=$(gh pr list --head "$wt_branch" --state open --json number,title --limit 1 --jq 'if length > 0 then "#\(.[0].number) \(.[0].title)" else empty end' 2>/dev/null || true)
					if [[ -n "$open_pr" ]]; then
						merge_info="open PR $open_pr"
					else
						merge_info="not merged"
					fi
				fi
			else
				merge_info="not merged"
			fi
		fi

		# Build status line
		status_parts="($sync)"
		[[ -n "$dirty" ]] && status_parts="$status_parts [$dirty]"
		if [[ -n "$merge_info" ]]; then
			printf "  %-25s %-8s %-15s %s\n" "$wt_branch" "${wt_commit:0:7}" "$status_parts" "$merge_info"
		else
			printf "  %-25s %-8s %s\n" "$wt_branch" "${wt_commit:0:7}" "$status_parts"
		fi
	done < <(git worktree list)
	echo ""

	# Remote branches not checked out as worktrees (10 most recent)
	worktree_branches=$(git worktree list | sed -n 's/.*\[\(.*\)\].*/\1/p')
	remote_only=()
	while IFS= read -r line; do
		ref="${line%% *}"
		branch="${ref#refs/remotes/origin/}"
		[[ "$branch" == "HEAD" ]] && continue
		if ! echo "$worktree_branches" | grep -qx "$branch"; then
			remote_only+=("$line")
		fi
	done < <(git for-each-ref --sort=-committerdate --format='%(refname) %(objectname:short)' refs/remotes/origin/)

	if (( ${#remote_only[@]} > 0 )); then
		echo "Remote branches without worktree:"
		limit=10
		shown=0
		for entry in "${remote_only[@]}"; do
			(( shown >= limit )) && break
			ref="${entry%% *}"
			commit="${entry##* }"
			branch="${ref#refs/remotes/origin/}"
			printf "  %-30s %s\n" "$branch" "$commit"
			shown=$((shown + 1))
		done
		rest=$(( ${#remote_only[@]} - shown ))
		if (( rest > 0 )); then
			echo "  ... and $rest more"
		fi
	else
		echo "All remote branches have worktrees."
	fi
	;;
clean)
	delete_remote=false
	target="$(_default_branch)"
	for arg in "$@"; do
		case "$arg" in
			--remote) delete_remote=true ;;
			*) target="$arg" ;;
		esac
	done
	root=$(_gwt_root)

	git fetch origin "$target" 2>/dev/null

	cleaned=0
	while IFS= read -r line; do
		wt_path=$(echo "$line" | awk '{print $1}')
		wt_branch=$(echo "$line" | sed -n 's/.*\[\(.*\)\].*/\1/p')

		[[ "$wt_path" == */.bare ]] && continue
		[[ -z "$wt_branch" ]] && continue
		[[ "$wt_branch" == "$target" ]] && continue

		# Check if branch is merged (regular merge or squash/rebase via gh)
		is_merged=false
		if git merge-base --is-ancestor "refs/heads/$wt_branch" "refs/remotes/origin/$target" 2>/dev/null; then
			is_merged=true
		elif command -v gh &>/dev/null; then
			merged_pr=$(gh pr list --head "$wt_branch" --state merged --json number --limit 1 --jq 'if length > 0 then "yes" else empty end' 2>/dev/null || true)
			[[ -n "$merged_pr" ]] && is_merged=true
		fi
		if [[ "$is_merged" == true ]]; then
			echo "==> Removing merged worktree: $wt_branch"
			git worktree remove "$root/$wt_branch"
			_cleanup_empty_parents "$root/$wt_branch" "$root"
			git branch -D "$wt_branch"
			# Delete remote branch if --remote flag was passed
			if [[ "$delete_remote" == true ]] && git show-ref --verify --quiet "refs/remotes/origin/$wt_branch" 2>/dev/null; then
				echo "    Deleting remote branch: origin/$wt_branch"
				git push origin --delete "$wt_branch" 2>/dev/null || echo "    Failed to delete remote branch (may already be deleted)"
			fi
			cleaned=$((cleaned + 1))
		fi
	done < <(git worktree list)

	if (( cleaned == 0 )); then
		echo "No merged worktrees to clean (target: $target)"
	else
		echo "==> Cleaned $cleaned merged worktree(s)"
		_update_workspace "$root"
	fi
	;;
rename|mv)
	old_branch="$1"
	new_branch="$2"
	if [[ -z "$old_branch" || -z "$new_branch" ]]; then
		echo "Usage: gwt rename <old-branch> <new-branch>" && exit 1
	fi
	root=$(_gwt_root)
	old_path="$root/$old_branch"
	new_path="$root/$new_branch"

	if [[ ! -d "$old_path" ]]; then
		echo "Worktree not found: $old_path" >&2 && exit 1
	fi

	# Rename the branch
	git branch -m "$old_branch" "$new_branch"
	# Move the worktree directory. Unlike `worktree add`, `worktree move` does
	# not create missing parents, so a nested target (fix/api-fix-x) needs one.
	mkdir -p "$(dirname "$new_path")"
	git worktree move "$old_path" "$new_path"
	# direnv trust is keyed on path, so the moved stub needs re-allowing
	_install_envrc_stub "$new_path" "$root"
	_cleanup_empty_parents "$old_path" "$root"
	_update_workspace "$root"
	echo "==> Renamed: $old_branch -> $new_branch"
	echo "==> cd $new_path"
	;;
rebase)
	target="${1:-$(_default_branch)}"
	root=$(_gwt_root)
	branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)

	if [[ "$branch" == "$target" ]]; then
		echo "Already on $target, nothing to rebase" && exit 0
	fi

	git fetch origin "$target" 2>/dev/null

	# Stash dirty state if needed
	stashed=false
	if [[ -n $(git status --porcelain 2>/dev/null) ]]; then
		echo "==> Stashing changes..."
		git stash push -u -m "gwt-rebase: auto-stash before rebase on $target"
		stashed=true
	fi

	echo "==> Rebasing $branch onto origin/$target..."
	if git rebase "origin/$target"; then
		echo "==> Rebase successful"
	else
		echo "==> Rebase failed — resolve conflicts, then run: git rebase --continue" >&2
		if [[ "$stashed" == true ]]; then
			echo "    Stashed changes will be restored after rebase completes: git stash pop" >&2
		fi
		exit 1
	fi

	# Restore stashed changes
	if [[ "$stashed" == true ]]; then
		echo "==> Restoring stashed changes..."
		git stash pop
	fi
	;;
sync)
	echo "==> Fetching all remote branches..."
	git fetch origin --prune

	synced=0
	skipped=0
	while IFS= read -r line; do
		wt_path=$(echo "$line" | awk '{print $1}')
		wt_branch=$(echo "$line" | sed -n 's/.*\[\(.*\)\].*/\1/p')

		[[ "$wt_path" == */.bare ]] && continue
		[[ -z "$wt_branch" ]] && continue

		# Skip if no remote tracking branch
		if ! git show-ref --verify --quiet "refs/remotes/origin/$wt_branch" 2>/dev/null; then
			continue
		fi

		local_commit=$(git rev-parse "refs/heads/$wt_branch" 2>/dev/null)
		remote_commit=$(git rev-parse "refs/remotes/origin/$wt_branch" 2>/dev/null)

		# Already up to date
		if [[ "$local_commit" == "$remote_commit" ]]; then
			continue
		fi

		# Check for dirty state in the worktree
		wt_dirty=$(git -C "$wt_path" status --porcelain 2>/dev/null || true)

		# Check if fast-forward is possible
		if git merge-base --is-ancestor "refs/heads/$wt_branch" "refs/remotes/origin/$wt_branch" 2>/dev/null; then
			if [[ -n "$wt_dirty" ]]; then
				echo "==> $wt_branch: stashing changes..."
				git -C "$wt_path" stash push -u -m "gwt-sync: auto-stash before pull"
				git -C "$wt_path" merge --ff-only "origin/$wt_branch"
				echo "==> $wt_branch: restoring stashed changes..."
				git -C "$wt_path" stash pop
			else
				git -C "$wt_path" merge --ff-only "origin/$wt_branch"
			fi
			echo "==> $wt_branch: fast-forwarded"
			synced=$((synced + 1))
		else
			echo "    $wt_branch: diverged from origin (skipped, use gwt rebase)"
			skipped=$((skipped + 1))
		fi
	done < <(git worktree list)

	if (( synced == 0 && skipped == 0 )); then
		echo "==> All worktrees up to date"
	else
		(( synced > 0 )) && echo "==> Synced $synced worktree(s)"
		(( skipped > 0 )) && echo "    Skipped $skipped diverged worktree(s)"
	fi
	;;
lazygit|lg)
	if _is_bare_root; then
		# At project root — find the first worktree that isn't the bare repo
		worktree_path=$(git worktree list --porcelain | awk '/^worktree / && !/\.bare$/ {print $2; exit}')
		if [[ -z "$worktree_path" ]]; then
			echo "No worktrees found. Create one first: gwt add <branch>" >&2
			exit 1
		fi
		echo "==> Entering worktree: $worktree_path"
		cd "$worktree_path"
	fi
	exec lazygit "$@"
	;;
*)
	echo "Usage: gwt <command>"
	echo ""
	echo "Commands:"
	echo "  clone <url> [dir]      Clone as bare repo with worktree layout"
	echo "  add <branch> [base]    Add worktree (creates branch if new)"
	echo "  rm <branch>            Remove a worktree"
	echo "  ls                     List all worktrees"
	echo "  status|st [target]     Show sync/merge status of worktrees (default: auto-detect)"
	echo "  clean [target] [--remote]  Remove worktrees merged into target (default: auto-detect)"
	echo "  rename|mv <old> <new>  Rename worktree branch and directory"
	echo "  rebase [target]        Rebase current branch onto target (default: auto-detect)"
	echo "  sync                   Pull remote changes for all worktrees (ff-only)"
	echo "  lazygit|lg             Launch lazygit (auto-enters worktree if at bare root)"
	;;
esac
